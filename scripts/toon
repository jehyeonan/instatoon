#!/usr/bin/env bash
# toon 진입 래퍼(bash 필요): 실행 위치와 무관하게 스킬 폴더의 toonkit 을 실행한다.
set -e
SRC="${BASH_SOURCE[0]}"
while [ -h "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$DIR/$SRC" ;; esac
done
SKILL="$(cd -P "$(dirname "$SRC")/.." && pwd)"
export PYTHONPATH="$SKILL${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONIOENCODING=utf-8
if command -v uv >/dev/null 2>&1; then
  # --no-project: 사용자 폴더의 pyproject.toml 을 무시한다. 프로젝트가 없을 때 uv 가 내는 경고 한 줄만 걸러 낸다.
  exec uv run --no-project --quiet --with pillow python -m toonkit.cli "$@" \
    2> >(grep -v '^WARN .--no-project. was provided' >&2)
fi
# uv 가 없으면 사용자 캐시의 venv 를 쓴다(스킬 폴더에는 쓰지 않는다).
if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)'; then
  echo "오류: Python 3.9 이상이 필요합니다(python3 를 설치하거나 uv 를 설치하세요)." >&2
  exit 2
fi
VENV="${XDG_CACHE_HOME:-$HOME/.cache}/instatoon/venv"
if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
fi
if ! "$VENV/bin/python" -c "import PIL" >/dev/null 2>&1; then
  "$VENV/bin/python" -m pip install --quiet pillow
fi
exec "$VENV/bin/python" -m toonkit.cli "$@"
